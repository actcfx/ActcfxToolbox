// 範例：把這個檔案複製到 functions/<slug>/api/hello.js
// 部署後就能用 GET /<slug>/api/hello 呼叫。
// 文件：https://developers.cloudflare.com/pages/functions/

export async function onRequestGet({ request, env }) {
  // env.KV / env.DB 等綁定在 wrangler.toml 或 Cloudflare 後台設定
  return Response.json({ hello: "world", time: new Date().toISOString() });
}

export async function onRequestPost({ request, env }) {
  const body = await request.json();
  return Response.json({ received: body });
}

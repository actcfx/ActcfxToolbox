---
import Icon from "./Icon.astro";
import VerbRow from "./VerbRow.astro";
import type { Lesson } from "../_types";

interface Props {
    section: string;
    lesson: Lesson;
}

const { section, lesson } = Astro.props;
---
<section class="lesson" id={`${section}-${lesson.n}`}>
    <h3>第{lesson.n}課</h3>
    <div class="card">
        <table>
            <thead>
                <tr>
                    <th><button class="lfold" type="button" aria-expanded="true" aria-label="收起或展開本課對照"><Icon name="chevron" /></button>辭書形</th>
                    <th></th>
                    <th>ます形</th>
                    <th>て形</th>
                    <th>類別</th>
                    <th>說明</th>
                </tr>
            </thead>
            <tbody>
                {lesson.rows.map((row) => <VerbRow row={row} />)}
            </tbody>
        </table>
    </div>
</section>
